# 复制为 .env 再填写（.env 已被 gitignore，永不入库）。
# docker compose 会自动读取同目录的 .env。

# 公网 HTTPS 根地址（设置了才会启用登录与 Secure Cookie）
# PUBLIC_ORIGIN=https://your.domain

# 时区（默认 Asia/Shanghai）
# TZ=Asia/Shanghai

# ── 可选：Litestream 异地备份（docker compose --profile backup）──
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
